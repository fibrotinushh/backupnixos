{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "nixos",
        "color": {
            "1": "#6888a8",
            "2": "#68a898",
            "3": "#60a0a0",
            "4": "#5890a8",
            "5": "#6888a8",
            "6": "#60a0a0"
        },
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "#6888a8",
            "title": "#5890a8",
            "separator": "#3a4058"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{##5890a8}{user-name} {##3a4058}@{##5890a8} {host-name}"
        },
        {
            "type": "break"
        },
        {
            "type": "os",
            "key": "  OS",
            "format": "{##b8c8d8}{pretty-name} {##5a6078}{arch}"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "format": "{##b8c8d8}{release}"
        },
        {
            "type": "uptime",
            "key": "  Uptime",
            "format": "{##b8c8d8}{formatted}"
        },
        {
            "type": "break"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "format": "{##b8c8d8}{pretty-name} {##5a6078}{version}"
        },
        {
            "type": "terminal",
            "key": "  Terminal",
            "format": "{##b8c8d8}{pretty-name}"
        },
        {
            "type": "de",
            "key": "  DE",
            "format": "{##b8c8d8}{pretty-name} {##5a6078}{version}"
        },
        {
            "type": "wm",
            "key": "  WM",
            "format": "{##b8c8d8}{pretty-name} {##5a6078}({protocol-name})"
        },
        {
            "type": "break"
        },
        {
            "type": "cpu",
            "key": "  CPU",
            "format": "{##b8c8d8}{name} {##5a6078}({cores-logical} threads)"
        },
        {
            "type": "gpu",
            "key": "  GPU",
            "format": "{##b8c8d8}{vendor} {name}"
        },
        {
            "type": "memory",
            "key": "  Memory",
            "percent": {
                "type": ["bar"],
                "green": 60,
                "yellow": 85
            },
            "format": "{used} / {total} {percentage-bar}"
        },
        {
            "type": "disk",
            "key": "  Disk",
            "percent": {
                "type": ["bar"],
                "green": 60,
                "yellow": 85
            },
            "format": "{size-used} / {size-total} {size-percentage-bar} {##5a6078}[{filesystem}]"
        }
    ]
}
